{
    "paths": {
        "/MIDI/Last": {
            "get": {
                "summary": "Recently received MIDI messages",
                "description": "The last few MIDI messages the plugin has seen, most recent last, as decimal bytes in fixed-width B1-B5 columns. The first line labels the columns; bytes absent from a message are left blank. Intended for working out what a controller sends while setting up an event mapping.",
                "responses": {
                    "200": {
                        "description": "Recent messages",
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                },
                                "example": " B1  B2  B3  B4  B5\n144  60 100            \n128  60   0            "
                            }
                        }
                    }
                }
            }
        },
        "/MIDI/Devices": {
            "get": {
                "summary": "Available MIDI input devices",
                "description": "The MIDI input ports visible to the player, for choosing which to listen on.",
                "responses": {
                    "200": {
                        "description": "Device names",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
